<?xml version="1.0"?>
<package format="3">
  <name>multi_agent_nav2</name>
  <version>0.1.0</version>
  <description>AgentLayer costmap_2d plugin</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>Apache-2.0</license>

  <!-- 빌드툴 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 빌드/런타임 의존성 -->
  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- [10-10 W1-2] AgentMaskCanvas 동등성 시험 -->
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>nav2_msgs</test_depend>  <!-- [10-10 W1-2][리뷰] publish 끝단 시험 -->


  <!-- pluginlib export -->
  <export>
    <!-- ament index에 플러그인 XML 등록 -->
    <!-- <pluginlib plugin="${prefix}/share/multi_agent_nav2/agent_layer_plugin.xml"/>
    <nav2_costmap_2d plugin="${prefix}/share/multi_agent_nav2/agent_layer_plugin.xml"/> -->
    <build_type>ament_cmake</build_type>
    <costmap_2d plugin="${prefix}/agent_layer_plugin.xml" />    
  </export>
</package>
