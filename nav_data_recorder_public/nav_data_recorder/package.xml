<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_data_recorder</name>
  <version>0.1.0</version>
  <description>Always-on, low-cost navigation data recorder (rosbag2 mcap, 10 min files, 7 day retention)</description>
  <maintainer email="maintainer@example.com">nav_data_recorder maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rcpputils</depend>
  <depend>rmw</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_data_recorder_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav_data_tools</exec_depend>
  <exec_depend>nav_data_profiles</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
